# jeil-nas-worker 환경값 — 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소·문서에 올리지 않는다.
# 줄 끝은 LF, 인코딩은 BOM 없는 UTF-8 (Windows 메모장 기본값이면 컨테이너에서 값이 깨진다).

# 중계 함수 주소 — 포털 Supabase 프로젝트의 함수 주소(…/functions/v1/jeil-nas-bridge)
NAS_BRIDGE_URL=

# 워커 전용 토큰 — 발급한 PC 의 .claude/nas_worker.token 에 있는 한 줄
NAS_WORKER_TOKEN=

# 적재 폴더의 NAS 내부 경로(DSM 「File Station → 속성 → 위치」에 나오는 /volumeN/… 꼴)
NAS_HOST_DATA_DIR=

# 그 폴더에 쓸 수 있는 계정의 번호(DSM SSH 에서 `id <계정>` 으로 확인)
NAS_RUN_UID=1000
NAS_RUN_GID=1000
